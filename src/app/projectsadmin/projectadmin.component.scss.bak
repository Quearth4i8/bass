/* Modern Admin Dashboard Styles */

.content {
  background-color: #f5f7fa;
  min-height: 100vh;
}

.fixed-messages {
  position: fixed;
  top: 80px;
  right: 20px;
  width: 350px;
  z-index: 1000;
}

/* Main Container */
.container {
  margin: 20px;
  margin-left: 220px;
  background: #ffffff;
  border-radius: 16px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  padding: 30px;
  min-height: calc(100vh - 100px);
}

/* Header Section */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30px;
  flex-wrap: wrap;
  gap: 20px;
}

.search-section {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  flex: 1;
}

.search-input {
  padding: 12px 16px;
  border: 2px solid #e2e8f0;
  border-radius: 10px;
  width: 180px;
  font-size: 14px;
  background: #fff;
  transition: all 0.3s ease;
  color: #2d3748;
}

.search-input::placeholder {
  color: #a0aec0;
}

.search-input:focus {
  outline: none;
  border-color: #1a5f7a;
  box-shadow: 0 0 0 3px rgba(26, 95, 122, 0.1);
}

/* Action Buttons */
.action-buttons {
  display: flex;
  gap: 12px;
}

.btn-primary {
  padding: 12px 24px;
  background: linear-gradient(135deg, #1a5f7a 0%, #159895 100%);
  color: white;
  border: none;
  border-radius: 10px;
  cursor: pointer;
  font-weight: 600;
  font-size: 14px;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  gap: 8px;
  box-shadow: 0 4px 12px rgba(26, 95, 122, 0.3);
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(26, 95, 122, 0.4);
}

.btn-secondary {
  padding: 12px 24px;
  background: linear-gradient(135deg, #57c5b6 0%, #159895 100%);
  color: white;
  border: none;
  border-radius: 10px;
  cursor: pointer;
  font-weight: 600;
  font-size: 14px;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  gap: 8px;
  box-shadow: 0 4px 12px rgba(87, 197, 182, 0.3);
}

.btn-secondary:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(87, 197, 182, 0.4);
}

/* Stats Cards */
.stats-section {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 20px;
  margin-bottom: 30px;
}

.stat-card {
  background: linear-gradient(135deg, #1a5f7a 0%, #159895 100%);
  padding: 20px;
  border-radius: 12px;
  color: white;
  box-shadow: 0 4px 15px rgba(26, 95, 122, 0.3);
}

.stat-card h3 {
  font-size: 28px;
  font-weight: 700;
  margin-bottom: 5px;
}

.stat-card p {
  font-size: 14px;
  opacity: 0.9;
}

/* Table Styles */
.table-wrapper {
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid #e2e8f0;
}

table {
  width: 100%;
  border-collapse: collapse;
}

thead {
  background: linear-gradient(135deg, #1a5f7a 0%, #159895 100%);
}

th {
  padding: 16px 20px;
  text-align: left;
  color: white;
  font-weight: 600;
  font-size: 13px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  white-space: nowrap;
}

tbody tr {
  transition: all 0.2s ease;
  border-bottom: 1px solid #e2e8f0;
}

tbody tr:hover {
  background: #f7fafc;
}

tbody tr:last-child {
  border-bottom: none;
}

td {
  padding: 16px 20px;
  text-align: left;
  color: #2d3748;
  font-size: 14px;
  vertical-align: middle;
}

/* ID Column */
.id-cell {
  font-weight: 700;
  color: #1a5f7a;
  font-size: 16px;
}

/* Edit Inputs */
.edit-input {
  width: 100%;
  padding: 10px 14px;
  border: 2px solid #e2e8f0;
  border-radius: 8px;
  font-size: 14px;
  background: #fff;
  color: #2d3748;
  transition: all 0.3s ease;
}

.edit-input:focus {
  outline: none;
  border-color: #1a5f7a;
  box-shadow: 0 0 0 3px rgba(26, 95, 122, 0.1);
}

.edit-display {
  padding: 10px 0;
  color: #2d3748;
  min-height: 40px;
  display: flex;
  align-items: center;
}

/* Dropdown */
.dropdown-select {
  width: 100%;
  padding: 10px 14px;
  border: 2px solid #e2e8f0;
  border-radius: 8px;
  font-size: 14px;
  background: #fff;
  color: #2d3748;
  cursor: pointer;
}

/* Action Icons */
.action-cell {
  width: 60px;
  text-align: center;
}

.action-btn {
  width: 36px;
  height: 36px;
  border-radius: 8px;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  margin: 0 auto;
}

.edit-btn {
  background: #edf2f7;
  color: #1a5f7a;
}

.edit-btn:hover {
  background: #1a5f7a;
  color: white;
}

.save-btn {
  background: #c6f6d5;
  color: #22543d;
}

.save-btn:hover {
  background: #48bb78;
  color: white;
}

.delete-btn {
  background: #fed7d7;
  color: #c53030;
}

.delete-btn:hover {
  background: #f56565;
  color: white;
}

/* Budget Cell */
.budget-cell {
  font-weight: 600;
  color: #1a5f7a;
}

/* Pagination */
.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 30px;
  gap: 16px;
}

.pagination-btn {
  padding: 10px 20px;
  border: 2px solid #e2e8f0;
  background: white;
  border-radius: 8px;
  cursor: pointer;
  font-weight: 500;
  color: #4a5568;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  gap: 8px;
}

.pagination-btn:hover:not(:disabled) {
  border-color: #1a5f7a;
  color: #1a5f7a;
  background: #f7fafc;
}

.pagination-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.pagination-info {
  font-size: 14px;
  color: #4a5568;
  font-weight: 500;
  padding: 0 20px;
}

/* Empty State */
.empty-state {
  text-align: center;
  padding: 60px 20px;
  color: #a0aec0;
}

.empty-state i {
  font-size: 48px;
  margin-bottom: 16px;
}

/* Responsive */
@media (max-width: 1200px) {
  .container {
    margin-left: 20px;
  }
  
  .search-input {
    width: 150px;
  }
}

@media (max-width: 768px) {
  .container {
    margin: 10px;
    padding: 20px;
  }
  
  .header {
    flex-direction: column;
    align-items: stretch;
  }
  
  .search-section {
    flex-direction: column;
  }
  
  .search-input {
    width: 100%;
  }
  
  .action-buttons {
    flex-direction: column;
  }
  
  .table-wrapper {
    overflow-x: auto;
  }
}

/* Sidebar adjustments */
.with-sidebar {
  margin-left: 200px;
}

.without-sidebar {
  margin-left: 0;
}

@media (max-width: 720px) {
  .with-sidebar {
    margin-left: 0;
  }
}

.custom-dialog-container .mat-dialog-container {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
}